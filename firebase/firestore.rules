rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'Admin';
    }
    
    function isLeader() {
      return isAuthenticated() && getUserData().role == 'Team Leader';
    }
    
    function isMember() {
      return isAuthenticated() && getUserData().role == 'Member';
    }
    
    function userTeamId() {
      return getUserData().teamId;
    }

    match /club/status {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/club/status) && request.auth != null;
      allow update: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      // Only Admin can create/update/delete teams
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      // Admin: read all
      // Team Leader: read self, own team, and external members (teamId == null)
      // Member: read self
      allow read: if isAdmin()
                  || (isLeader() && (!("teamId" in resource.data) || resource.data.teamId == userTeamId() || resource.data.teamId == null || userId == request.auth.uid))
                  || (isAuthenticated() && userId == request.auth.uid);
      
      // Creating Admin is ONLY allowed if club/status doesn't exist
      allow create: if (isAdmin() && request.resource.data.role != 'Admin') 
                    || (!exists(/databases/$(database)/documents/club/status) && request.resource.data.role == 'Admin' && request.auth.uid == userId);
      
      allow delete: if isAdmin();
      
      allow update: if 
        // Self-update for anyone (no role/team change)
        (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.teamId == resource.data.teamId)
        || 
        // Admin updating someone else (cannot change them to Admin)
        (isAdmin() && request.auth.uid != userId && request.resource.data.role != 'Admin')
        ||
        // Team Leader managing team membership
        (isLeader() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']) && (request.resource.data.teamId == userTeamId() || request.resource.data.teamId == null) && (resource.data.teamId == userTeamId() || resource.data.teamId == null));
    }
    
    match /attendance/{recordId} {
      allow read: if isAdmin() 
                  || (isLeader() && resource.data.teamId == userTeamId())
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // ONLY Admin can create or update attendance.
      allow create, update, delete: if isAdmin();
    }
  
    // =========================================================================
    // LEARNING CORE (Phase 1)
    // =========================================================================

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Progress: Members write their own; Leaders read their team's; Admins read all
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/users/$(resource.data.memberId)).data.teamId)
      );
      // Members can only write their own progress (not others')
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }

    // =========================================================================
    // ASSIGNMENTS & QUIZZES (Phase 2)
    // =========================================================================

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == resource.data.teamId)
      );
      // Members write their own; no peer review (V1 boundary)
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/users/$(resource.data.memberId)).data.teamId)
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }

    // =========================================================================
    // TEAM OBJECTIVES, TASKS, & PROJECTS (Phase 3)
    // =========================================================================

    match /objectives/{objectiveId} {
      // Members can read but NOT write objectives (only Leaders/Admins define objectives)
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
    }
    match /constraints/{constraintId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
    }
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
    }
    match /task_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      // Members can only update their OWN task assignment (e.g. marking COMPLETED)
      allow write: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == request.resource.data.teamId) ||
        request.auth.uid == resource.data.memberId
      );
    }
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
    }
    match /project_milestones/{milestoneId} {
      allow read: if isAuthenticated();
      // Tightened: only Leaders and Admins manage milestones
      allow write: if isAuthenticated() && (isAdmin() || isLeader());
    }

    // =========================================================================
    // PROJECT SUBMISSIONS & EVALUATION (Phase 4)
    // =========================================================================

    match /project_submissions/{subId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId) ||
        request.auth.uid == resource.data.memberId
      );
      // Members write their own. Leaders can update status (e.g. CHANGES_REQUESTED).
      allow write: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == request.resource.data.teamId) ||
        request.auth.uid == request.resource.data.memberId
      );
    }

    match /rubrics/{rubricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only Admins create/version rubrics
    }

    match /evaluations/{evalId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.teamId) ||
        request.auth.uid == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.memberId
      );
      // Only Admins and Team Leaders may create evaluations (no peer review - V1 boundary)
      allow write: if isAuthenticated() && (isAdmin() || isLeader());
      // Members CANNOT alter evaluator scores
      allow update: if isAdmin() || (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.teamId);
    }

    // =========================================================================
    // GROWTH & SKILLS (Phase 5) - FR-GROW-03: Never manually editable by members
    // =========================================================================

    match /growth/{snapshotId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId) ||
        request.auth.uid == resource.data.memberId
      );
      // FR-GROW-03: Growth is NEVER manually editable by members/leaders
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isLeader() ||
        request.auth.uid == resource.data.memberId
      );
      // Leaders can grant skills as evidence-based acknowledgment; Admin always can
      allow write: if isAuthenticated() && (isAdmin() || isLeader());
    }

    // =========================================================================
    // NOTIFICATIONS & AUDIT (Phase 6)
    // =========================================================================

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow delete: if false; // Soft delete only (mark readAt)
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Append-only - no updates or deletes by ANYONE (NFR-OBS-01)
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    
    // =========================================================================
    // DEFAULT DENY (Catch-all - rejects any unmatched collection)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}