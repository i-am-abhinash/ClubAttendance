rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'Admin';
    }
    
    function isLeader() {
      return isAuthenticated() && getUserData().role == 'Team Leader';
    }
    
    function isMember() {
      return isAuthenticated() && getUserData().role == 'Member';
    }
    
    function userTeamId() {
      return getUserData().teamId;
    }

    match /club/status {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/club/status) && isAdmin();
      allow update: if false; // Status should just exist
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAdmin()
                  || (isLeader() && (!("teamId" in resource.data) || resource.data.teamId == userTeamId() || resource.data.teamId == null || userId == request.auth.uid))
                  || (isAuthenticated() && userId == request.auth.uid);
      
      allow create: if (isAdmin() && request.resource.data.role != 'Admin') 
                    || (!exists(/databases/$(database)/documents/club/status) 
                        && request.resource.data.role == 'Admin' 
                        && request.auth.uid == userId
                        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      
      allow delete: if isAdmin() && resource.data.role != 'Admin';
      
      allow update: if 
        (isAuthenticated() && request.auth.uid == userId 
          && request.resource.data.role == resource.data.role 
          && request.resource.data.teamId == resource.data.teamId
          && (
            (resource.data.role == 'Admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'mustChangePassword', 'updatedAt']))
            || (resource.data.role != 'Admin' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']))
          )
        )
        || 
        (isAdmin() && request.auth.uid != userId 
          && resource.data.role != 'Admin' 
          && (request.resource.data.role == 'Member' || request.resource.data.role == 'Team Leader')
        )
        ||
        (isLeader() 
          && resource.data.role == 'Member'
          && request.resource.data.role == 'Member'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']) 
          && (request.resource.data.teamId == userTeamId() || request.resource.data.teamId == null) 
          && (resource.data.teamId == userTeamId() || resource.data.teamId == null));
    }
    
    match /attendance/{recordId} {
      allow read: if isAdmin() 
                  || (isLeader() && resource.data.teamId == userTeamId())
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      allow create, update, delete: if isAdmin();
    }
  
    // =========================================================================
    // LEARNING CORE (Phase 1)
    // =========================================================================

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/users/$(resource.data.memberId)).data.teamId)
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }

    // =========================================================================
    // ASSIGNMENTS & QUIZZES (Phase 2)
    // =========================================================================

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /assignment_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == resource.data.teamId)
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.memberId ||
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/users/$(resource.data.memberId)).data.teamId)
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.memberId ||
        isAdmin()
      );
    }

    // =========================================================================
    // TEAM OBJECTIVES, TASKS, & PROJECTS (Phase 3)
    // =========================================================================

    match /objectives/{objectiveId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId));
    }
    match /constraints/{constraintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId));
    }
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId));
    }
    match /task_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == request.resource.data.teamId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId) ||
        (request.auth.uid == resource.data.memberId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']))
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId)
      );
    }
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId));
    }
    match /project_milestones/{milestoneId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == request.resource.data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == resource.data.teamId));
    }

    // =========================================================================
    // PROJECT SUBMISSIONS & EVALUATION (Phase 4)
    // =========================================================================

    match /project_submissions/{subId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId) ||
        request.auth.uid == resource.data.memberId
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == request.resource.data.teamId) ||
        (request.auth.uid == request.resource.data.memberId && request.resource.data.teamId == userTeamId())
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId && userTeamId() == request.resource.data.teamId) ||
        (request.auth.uid == request.resource.data.memberId && request.resource.data.teamId == userTeamId() && resource.data.teamId == userTeamId())
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId)
      );
    }

    match /rubrics/{rubricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /evaluations/{evalId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.teamId) ||
        request.auth.uid == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.memberId
      );
      allow create: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(request.resource.data.submissionId)).data.teamId));
      allow update: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.teamId && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(request.resource.data.submissionId)).data.teamId));
      allow delete: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == get(/databases/$(database)/documents/project_submissions/$(resource.data.submissionId)).data.teamId));
    }

    // =========================================================================
    // GROWTH & SKILLS (Phase 5)
    // =========================================================================

    match /growth/{snapshotId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (isLeader() && userTeamId() == resource.data.teamId) ||
        request.auth.uid == resource.data.memberId
      );
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isLeader() ||
        request.auth.uid == resource.data.memberId
      );
      allow write: if isAuthenticated() && (isAdmin() || (isLeader() && userTeamId() == get(/databases/$(database)/documents/users/$(request.resource.data.memberId)).data.teamId));
    }

    // =========================================================================
    // NOTIFICATIONS & AUDIT (Phase 6)
    // =========================================================================

    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && (
        request.auth.uid == resource.data.recipientId ||
        isAdmin()
      );
      // ONLY Admin and Leaders can send notifications. Members can't.
      allow create: if isAdmin() || isLeader();
      allow delete: if false; 
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isLeader();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
