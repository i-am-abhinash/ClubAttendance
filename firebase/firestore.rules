rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'Admin';
    }
    
    function isLeader() {
      return isAuthenticated() && getUserData().role == 'Team Leader';
    }
    
    function isMember() {
      return isAuthenticated() && getUserData().role == 'Member';
    }
    
    function userTeamId() {
      return getUserData().teamId;
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      // Only Admin can create/update/delete teams
      allow write: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Admin can do anything
      // A Team Leader can update a user IF they are only updating the teamId
      // and they are setting it to their own teamId, OR setting it to null (removing from their team)
      // A user can update their own profile fields EXCEPT role and teamId
      
      allow create: if isAdmin();
      allow delete: if isAdmin();
      
      allow update: if isAdmin() 
        || (
           isAuthenticated() 
           && request.auth.uid == userId 
           && request.resource.data.role == resource.data.role 
           && request.resource.data.teamId == resource.data.teamId
        )
        || (
           isLeader()
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId'])
           && (
             request.resource.data.teamId == userTeamId() || 
             request.resource.data.teamId == null
           )
           && (
             resource.data.teamId == userTeamId() || 
             resource.data.teamId == null
           )
        );
    }
    
    match /attendance/{recordId} {
      allow read: if isAdmin() 
                  || (isLeader() && resource.data.teamId == userTeamId())
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      
      // ONLY Admin can create or update attendance.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
